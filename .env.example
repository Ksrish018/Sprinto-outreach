# Copy to .env and fill in. Never commit .env.
# In production these live in Vercel as Sensitive environment variables.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
HUNTER_API_KEY=
DATABASE_URL=
HUBSPOT_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Every draft is addressed to this inbox only (pilot mode).
SEND_TO_EMAIL=
# Shared secret that cron and sync endpoints require.
CRON_SECRET=
# off = all external APIs are mocked (default for tests and CI).
LIVE_APIS=off
