{
  "name": "sprinto-outreach",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file=.env --import ./scripts/dns-fallback.mjs scripts/migrate.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "golden": "node --env-file=.env --import ./scripts/dns-fallback.mjs node_modules/vitest/vitest.mjs run --config vitest.golden.mts",
    "dev:local": "node --import ./scripts/dns-fallback.mjs ./node_modules/next/dist/bin/next dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "cheerio": "^1.1.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "undici": "^8.12.4",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "csstype": "3.2.3"
  },
  "engines": {
    "node": ">=22"
  }
}
